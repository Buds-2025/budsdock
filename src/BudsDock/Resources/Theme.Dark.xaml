<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="WindowBackgroundColor">#0B0E13</Color>
  <Color x:Key="ContentColor">#0B0E13</Color>
  <Color x:Key="HeaderColor">#11151B</Color>
  <Color x:Key="SidebarColor">#131820</Color>
  <Color x:Key="SurfaceColor">#181E27</Color>
  <Color x:Key="SurfaceAltColor">#202733</Color>
  <Color x:Key="SurfaceHoverColor">#283241</Color>
  <Color x:Key="DockSurfaceColor">#151B24</Color>
  <Color x:Key="BorderColor">#303947</Color>
  <Color x:Key="BorderStrongColor">#3A4351</Color>
  <Color x:Key="TextPrimaryColor">#F4F7FB</Color>
  <Color x:Key="TextSecondaryColor">#AAB4C3</Color>
  <Color x:Key="TextTertiaryColor">#8390A3</Color>
  <Color x:Key="AccentColor">#7C9CFF</Color>
  <Color x:Key="AccentSoftColor">#1D315E</Color>
  <Color x:Key="DangerColor">#FF8C94</Color>
  <Color x:Key="IconTileColor">#3C46566E</Color>
  <Color x:Key="IconForegroundColor">#F1F3FA</Color>
  <Color x:Key="GlowColor">#8FACFF</Color>
  <Color x:Key="MenuBackgroundColor">#11151B</Color>
  <Color x:Key="MenuHoverColor">#283241</Color>
  <Color x:Key="MenuBorderColor">#3A4351</Color>
  <Color x:Key="MenuTextColor">#F5F7FB</Color>
  <Color x:Key="MenuDisabledTextColor">#8693A8</Color>

  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
  <SolidColorBrush x:Key="ContentBrush" Color="{StaticResource ContentColor}"/>
  <SolidColorBrush x:Key="HeaderBrush" Color="{StaticResource HeaderColor}"/>
  <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
  <SolidColorBrush x:Key="DockSurfaceBrush" Color="{StaticResource DockSurfaceColor}"/>
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
  <SolidColorBrush x:Key="IconTileBrush" Color="{StaticResource IconTileColor}"/>
  <SolidColorBrush x:Key="IconForegroundBrush" Color="{StaticResource IconForegroundColor}"/>
  <SolidColorBrush x:Key="GlowBrush" Color="{StaticResource GlowColor}"/>
  <SolidColorBrush x:Key="MenuBackgroundBrush" Color="{StaticResource MenuBackgroundColor}"/>
  <SolidColorBrush x:Key="MenuHoverBrush" Color="{StaticResource MenuHoverColor}"/>
  <SolidColorBrush x:Key="MenuBorderBrush" Color="{StaticResource MenuBorderColor}"/>
  <SolidColorBrush x:Key="MenuTextBrush" Color="{StaticResource MenuTextColor}"/>
  <SolidColorBrush x:Key="MenuDisabledTextBrush" Color="{StaticResource MenuDisabledTextColor}"/>

  <BitmapImage x:Key="BrandMarkSource" UriSource="pack://application:,,,/Assets/BudsDock-mark-dark.png"/>
</ResourceDictionary>
